+# Strict json_schema is enforced by OpenAI but not by every OpenRouter provider: deepseek sometimes
+# answers under another key or with an empty reply, and one such reply used to abort the whole bug.
+# Ask again rather than lose every candidate, and accept a lone renamed field.
+JSON_REPLY_ATTEMPTS = 3
+# deepseek's other failure mode is `{` followed by whitespace up to the provider's length cap, 25-90
+# minutes a reply over OpenRouter and 16h of one 25-bug run. Streaming lets such a reply be cut as
+# soon as it starts: inside a JSON string newlines and tabs arrive escaped, so no real reply has a
+# run of raw whitespace anywhere near this long.
+WHITESPACE_RUN_LIMIT = 200
+# Backstop for a stall that streams no content at all (one reply came back empty after 43 minutes).
+REPLY_TIME_LIMIT_S = 900
+# OpenRouter's provider routing as JSON, e.g. {"sort": "throughput", "require_parameters": true}.
+# Unset leaves routing to OpenRouter, which also picks providers that ignore json_schema; OpenAI's
+# own endpoint rejects the field, so it must stay unset for a model served there.
+PROVIDER_ROUTING = json.loads(os.environ.get("LOOPREPAIR_PROVIDER") or "null")
